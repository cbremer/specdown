{
  "name": "specdown",
  "version": "0.0.234",
  "description": "SpecDown: A lightweight, browser-based markdown viewer with enhanced diagram navigation capabilities",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "npm run build && electron .",
    "desktop:html": "npm run build:html && node scripts/desktop-html.js",
    "desktop:build": "npm run build && electron-builder",
    "desktop:mas": "npm run build && node scripts/build-mas-native.js && electron-builder --config electron-builder.mas.js --mac mas --universal",
    "desktop:mas-dev": "npm run build && node scripts/build-mas-native.js && electron-builder --config electron-builder.mas.js --mac mas-dev --arm64",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:report": "jest --verbose --json --outputFile=test-results.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "dev:html": "vite --mode html",
    "build": "vite build && node scripts/copy-static.js",
    "build:html": "vite build --mode html && node scripts/copy-static.js",
    "preview": "vite preview",
    "preview:html": "npm run build:html && vite preview --mode html",
    "version": "node scripts/sync-version.js && git add markdown-viewer/src/main.js",
    "postinstall": "node scripts/patch-macos-keychain.js",
    "test:watchers": "node scripts/test-desktop-watchers.js"
  },
  "keywords": [
    "markdown",
    "viewer",
    "mermaid",
    "diagrams",
    "documentation"
  ],
  "author": "Chris Bremer",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "45.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "markdown-viewer/**/*.js",
      "!markdown-viewer/dist/**",
      "!markdown-viewer/vendor/**",
      "!markdown-viewer/**/*.test.js",
      "!markdown-viewer/**/*.spec.js",
      "desktop/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "coverageThreshold": {
      "./desktop/main.js": {
        "statements": 28,
        "branches": 20,
        "functions": 16,
        "lines": 29
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "build": {
    "electronDownload": {
      "checksums": {
        "electron-v45.1.0-darwin-arm64.zip": "002b71efcf90e247317d3da486f2d4e51860e9c2889d49f33e229ab2268b0f3b",
        "electron-v45.1.0-darwin-x64.zip": "b4667d820149e33a6f016d103de0fcf5d6f05b8297a204232a0d970c00b163a5",
        "electron-v45.1.0-linux-arm64.zip": "64b78d93d1129ab805cdc0f2710f446716afbe814a1d08e639dab3175d2285a1",
        "electron-v45.1.0-linux-x64.zip": "9dafab2c57ce209f8f716f8f3e4fddd8ffe0820e2455bfbbfc00b0fc13e03a3b",
        "electron-v45.1.0-mas-arm64.zip": "d7d7872db44cbb301596ab26860746e02f5cbc1db7b4abfaed297184bbf3a954",
        "electron-v45.1.0-mas-x64.zip": "4608fb25a1b0dd20e5291a611dff73d113123aa547d0c3ba4ddc407517cd40e5",
        "electron-v45.1.0-win32-arm64.zip": "c0adce10031826896060bba848777bf9f059bfe4a2f7f9d4795008498eeeb248",
        "electron-v45.1.0-win32-x64.zip": "55eaba17abff7b5bba6c3bbc85068967379024fe742fe9c7fdba9118922ccbe2"
      }
    },
    "appId": "com.specdown.desktop",
    "productName": "Specdown Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "!desktop/native/**",
      "markdown-viewer/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/chokidar/**",
      "**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cbremer",
        "repo": "specdown"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Specdown-Desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Specdown Desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon-square.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Specdown-Desktop-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon-square.png",
      "artifactName": "Specdown-Desktop-${version}.${ext}"
    },
    "artifactName": "Specdown-Desktop-${version}-${arch}.${ext}"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    },
    "minimatch@9 || 10": "11.0.3",
    "glob@10 || 13 || 14": "14.0.3",
    "filelist": {
      "minimatch": "11.0.3"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "8.0.0"
    }
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "11.12.0",
    "marked": "^18.1.3",
    "mermaid": "12.3.0"
  }
}
