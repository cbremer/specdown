{
  "name": "specdown",
  "version": "0.0.234",
  "description": "SpecDown: A lightweight, browser-based markdown viewer with enhanced diagram navigation capabilities",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "npm run build && electron .",
    "desktop:html": "npm run build:html && node scripts/desktop-html.js",
    "desktop:build": "npm run build && electron-builder",
    "desktop:mas": "npm run build && node scripts/build-mas-native.js && electron-builder --config electron-builder.mas.js --mac mas --universal",
    "desktop:mas-dev": "npm run build && node scripts/build-mas-native.js && electron-builder --config electron-builder.mas.js --mac mas-dev --arm64",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:report": "jest --verbose --json --outputFile=test-results.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite",
    "dev:html": "vite --mode html",
    "build": "vite build && node scripts/copy-static.js",
    "build:html": "vite build --mode html && node scripts/copy-static.js",
    "preview": "vite preview",
    "preview:html": "npm run build:html && vite preview --mode html",
    "version": "node scripts/sync-version.js && git add markdown-viewer/src/main.js",
    "postinstall": "node scripts/patch-macos-keychain.js",
    "test:watchers": "node scripts/test-desktop-watchers.js"
  },
  "keywords": [
    "markdown",
    "viewer",
    "mermaid",
    "diagrams",
    "documentation"
  ],
  "author": "Chris Bremer",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "45.2.3",
    "electron-builder": "^26.8.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "markdown-viewer/**/*.js",
      "!markdown-viewer/dist/**",
      "!markdown-viewer/vendor/**",
      "!markdown-viewer/**/*.test.js",
      "!markdown-viewer/**/*.spec.js",
      "desktop/**/*.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "coverageThreshold": {
      "./desktop/main.js": {
        "statements": 28,
        "branches": 20,
        "functions": 16,
        "lines": 29
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "build": {
    "electronDownload": {
      "checksums": {
        "electron-v45.2.3-darwin-arm64.zip": "4d7c429064087a47b855d9bd06c76ead4819b7f02b385de232d4a5c37ecef55f",
        "electron-v45.2.3-darwin-x64.zip": "d87323533cc8750ef177e5b48058f7a8b381f677d4e103cc63360006c08829c2",
        "electron-v45.2.3-linux-arm64.zip": "397c060fd9da99ab72b78787d65545b432fcadf13ef6c96658e4f525692aae0f",
        "electron-v45.2.3-linux-x64.zip": "a87fe741f6d121285117e574da6c9a2e65210d410123bbc04713b099add0263b",
        "electron-v45.2.3-mas-arm64.zip": "76bf57029ad822866775d5e88c57d53fb1460fb9e1f38424d606ff755d6c219c",
        "electron-v45.2.3-mas-x64.zip": "50b590fe1538e8f45f85b94d512f5e4e0e8fc20e8e4b437d9d1808d84ce05f5f",
        "electron-v45.2.3-win32-arm64.zip": "f664bd7a4adfc45ac237a6f5fbf6c8e041b71b174466e9cb6fc9416c918e249d",
        "electron-v45.2.3-win32-x64.zip": "489cd061908e697394b004298bf5ffd345c935d10e8ca197ba819f019ab2dec0"
      }
    },
    "appId": "com.specdown.desktop",
    "productName": "Specdown Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "!desktop/native/**",
      "markdown-viewer/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/chokidar/**",
      "**/*.node"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cbremer",
        "repo": "specdown"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Specdown-Desktop-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Specdown Desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon-square.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Specdown-Desktop-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon-square.png",
      "artifactName": "Specdown-Desktop-${version}.${ext}"
    },
    "artifactName": "Specdown-Desktop-${version}-${arch}.${ext}"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    },
    "minimatch@9 || 10": "11.0.3",
    "glob@10 || 13 || 14": "14.0.3",
    "filelist": {
      "minimatch": "11.0.3"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "8.0.0"
    }
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "11.12.0",
    "marked": "^18.1.3",
    "mermaid": "12.3.0"
  }
}
